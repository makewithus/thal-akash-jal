# Protect mailer/ directory.
# config.php must never be served directly.
# vendor/ and PHPMailer/ source must never be served directly.
# Only send.php should be publicly accessible.

<FilesMatch "^(?!send\.php$).*$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Prevent directory listing
Options -Indexes

# Prevent PHP files other than send.php being served (belt-and-suspenders)
<FilesMatch "^(config|autoload|Exception|PHPMailer|SMTP)\.php$">
    Order allow,deny
    Deny from all
</FilesMatch>
